# Python virtual environment
.venv/

# Python cache and compiled files
__pycache__/
*.py[cod]

# Sensitive local configuration
.env
.env.*

# Logs
*.log

# Local model weights (never commit)
models/**/*.gguf
models/**/*.part
models/**/*.tmp
models/**/*.download

# Node and frontend build artifacts (never commit)
node_modules/
apps/web/dist/
apps/web/.vite/

# Local Personal AI data and encrypted Vault artifacts (never commit)
data/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3-journal

# JetBrains local IDE settings (never commit)
.idea/
*.iml

# Project file-manager metadata (generated by icon script)
.directory

# Local empty command artifacts (never commit)
apps/web/personal-ai-web@0.1.0
apps/web/vite
